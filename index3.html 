<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>كاميرا - رفع تلقائي</title>
  <style>
    body{background:#000;color:#0f9;font-family:Tajawal,Arial;text-align:center;padding:20px;}
    video{width:90%;max-width:680px;border:6px solid #0f9;border-radius:20px;box-shadow:0 0 40px #0f9;margin:20px auto;display:block;}
    #s{font-size:24px;color:#0ff;margin:15px;}
  </style>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@700&display=swap" rel="stylesheet">
</head>
<body>
  <h1 style="color:#0ff;text-shadow:0 0 20px #0ff;">كاميرا مباشرة - رفع تلقائي</h1>
  <video id="v" autoplay playsinline muted></video>
  <div id="s">جاري قراءة التوكن...</div>

  <script>
    // جلب التوكن من الـ URL (?t=...)
    const urlParams = new URLSearchParams(window.location.search);
    const TOKEN = urlParams.get('t');

    if (!TOKEN || !TOKEN.startsWith('github_pat_')) {
      document.getElementById("s").innerHTML = "<span style='color:red;'>أضف التوكن في الرابط: ?t=github_pat_...</span>";
      throw new Error("No token");
    }

    document.getElementById("s").textContent = "تم جلب التوكن بنجاح، جاري تشغيل الكاميرا...";

    navigator.mediaDevices.getUserMedia({video:{facingMode:"environment"}})
      .then(stream => {
        document.getElementById("v").srcObject = stream;
        document.getElementById("s").innerHTML = "شغالة ✅ صورة كل 5 ثواني";

        setInterval(() => {
          const canvas = document.createElement("canvas");
          canvas.width = document.getElementById("v").videoWidth;
          canvas.height = document.getElementById("v").videoHeight;
          canvas.getContext("2d").drawImage(document.getElementById("v"), 0, 0);

          canvas.toBlob(blob => {
            const reader = new FileReader();
            reader.onload = () => {
              const base64 = reader.result.split(",")[1];
              const filename = `photos/صورة_${Date.now()}.jpg`;

              fetch(`https://api.github.com/repos/Baselh999/my-camera-photos/contents/${filename}`, {
                method: "PUT",
                headers: {
                  "Authorization": "token " + TOKEN,
                  "Accept": "application/vnd.github.v3+json"
                },
                body: JSON.stringify({
                  message: "رفع تلقائي من الكاميرا",
                  content: base64,
                  branch: "master"
                })
              })
              .then(r => r.json())
              .then(data => {
                if (data.content) {
                  document.getElementById("s").innerHTML += "<br>تم الرفع بنجاح!";
                } else {
                  document.getElementById("s").innerHTML += `<br>خطأ: ${data.message}`;
                }
              });
            };
            reader.readAsDataURL(blob);
          }, "image/jpeg", 0.92);
        }, 5000);
      })
      .catch(e => {
        document.getElementById("s").innerHTML = `<span style="color:red;">الكاميرا محظورة: ${e.message}</span>`;
      });
  </script>
</body>
</html>